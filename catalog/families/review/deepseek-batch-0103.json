    {
     "item": 3,
     "ok": false,
     "criteria": [
      "en",
      "ru",
      "sense"
     ],
     "problem": "English uses simple present 'come' but Danish 'kommer' is present tense, which can be future or habitual. The Russian 'приходят' is habitual, but the Danish sentence with 'til festen' and 'alle sammen' strongly implies a specific future event (like the others). The English and Russian should match the future meaning. Also, Russian 'На вечеринку приходят все её братья и сёстры' changes word order and adds 'братья и сёстры' instead of just 'søskende' (siblings), which is acceptable but the habitual aspect is wrong. The sense is not demonstrated as a specific event like the other sentences.",
     "danish_ok": true,
     "en": "Her siblings are all coming to the party.",
     "ru": "Её братья и сёстры все придут на вечеринку."
    },
    {
     "item": 4,
     "ok": false,
     "criteria": [
      "en",
      "ru",
      "sense"
     ],
     "problem": "Danish 'tager' is present tense, often used for future events, but English 'go' and Russian 'ходят' are habitual, which does not match the specific event implied by 'til festen' with 'alle sammen'. The English and Russian should reflect a future event, not a habitual action. The sense is not demonstrated as a specific event.",
     "danish_ok": true,
     "en": "My friends are all going to the party.",
     "ru": "Мои друзья все пойдут на вечеринку."
    }
   ]
