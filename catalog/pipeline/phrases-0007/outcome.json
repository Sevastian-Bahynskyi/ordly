 {
  "id": "e:nære sig|phrase#1",
  "kind": "example",
  "unit": "entry:nære sig|phrase",
  "passed": false,
  "stage": "review",
  "problems": [
   "sense: 'Han nærer sig for at spørge om hjælp' does not show the meaning 'to hesitate (out of shyness)'; 'nærer sig' here is a calque or misconstruction and does not convey hesitation in Danish.",
   "translations: English translation 'He feeds to ask for help' is nonsensical and does not match the intended meaning.",
   "translations: Russian translation 'Он кормится, чтобы попросить о помощи' is nonsensical and does not match the intended meaning.",
   "translations: Ukrainian translation 'Він годує, щоб попросити допомоги' is nonsensical and does not match the intended meaning.",
   "English translation 'He feeds to ask for help.' is wrong; it translates 'nærer' literally as 'feeds' instead of 'hesitates'.",
   "Russian translation 'Он кормится, чтобы попросить о помощи.' is wrong; it translates 'nærer' literally as 'кормится' instead of 'стесняется/не решается'.",
   "Ukrainian translation 'Він годує, щоб попросити допомоги.' is wrong; it translates 'nærer' literally as 'годує' instead of 'соромиться/не наважується'."
  ]
 },
